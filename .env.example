# PostgreSQL
#
# Two roles, deliberately. `watari` owns the schema and is a superuser, so it
# bypasses Row-Level Security — it is only for migrations, seeding, the worker
# and auth lookups. `watari_app` is unprivileged and IS subject to RLS; it is
# what the API serves requests with. Pointing DATABASE_URL at the owner would
# silently disable tenant isolation. See migration 0003.
POSTGRES_USER=watari
POSTGRES_PASSWORD=watari_dev_password
POSTGRES_DB=watari

# The unprivileged application role, created by migration 0003.
APP_DB_USER=watari_app
APP_DB_PASSWORD=watari_app_dev_password

# Request path — RLS enforced.
DATABASE_URL=postgresql+asyncpg://watari_app:watari_app_dev_password@postgres:5432/watari
# Migrations, seeding, worker, auth lookups — RLS bypassed.
ADMIN_DATABASE_URL=postgresql+asyncpg://watari:watari_dev_password@postgres:5432/watari

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=watari-evidence
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# App
APP_ENV=development
APP_DEBUG=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
